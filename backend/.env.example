# 개발용 OAuth 키 견본.
# 1. 같은 폴더에 .env로 복사한다: cp .env.example .env
# 2. .env에서 쓸 줄의 맨 앞 #을 지우고 값을 채운다
#    (빈 값으로 두면 안 된다. 빈 값은 "키 없음"이 아니라 빈 문자열로 들어가 앱이 시작되지 않는다)
# .env는 .gitignore 대상이라 커밋되지 않는다. 이 견본 파일에는 값을 넣지 않는다.
# dev 프로필(--spring.profiles.active=dev)로 실행하면 자동으로 읽는다.

# 구글 OAuth 클라이언트 (Google Cloud 콘솔 > Google Auth Platform > 클라이언트)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# 카카오: client-id는 JavaScript 키가 아니라 REST API 키다
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=

# 네이버 (기본으로 꺼져 있다. 켜려면 LOGIN_PROVIDERS도 함께 설정한다)
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# LOGIN_PROVIDERS=google,kakao,naver
