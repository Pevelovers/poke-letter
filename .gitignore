# =========================================================
# poke-letter .gitignore
# 구조: frontend/ (React + TypeScript), backend/ (Java + Spring)
# 원칙(AGENTS.md): 생성 파일, 의존성, 비밀 정보, 개인 환경 파일은 커밋하지 않는다.
# =========================================================

# ---------------------------------------------------------
# 비밀 정보 / 환경 변수 (절대 커밋 금지)
# ---------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.jks
*.keystore
secrets/
credentials.json

# Spring: 로컬·비밀 프로필 설정 (공통 설정 application.yml은 커밋)
application-local.yml
application-local.yaml
application-local.properties
application-secret.yml
application-secret.yaml
application-secret.properties

# ---------------------------------------------------------
# Git
# ---------------------------------------------------------
# 병합/패치 충돌 시 생기는 백업 파일
*.orig
*.rej
*.BACKUP.*
*.BASE.*
*.LOCAL.*
*.REMOTE.*
*.patch.bak

# ---------------------------------------------------------
# GitHub
# ---------------------------------------------------------
# .github/ (템플릿, 워크플로)는 커밋한다. 로컬 act 실행 결과만 제외.
.secrets
.actrc

# ---------------------------------------------------------
# macOS
# ---------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# ---------------------------------------------------------
# Windows
# ---------------------------------------------------------
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
*.cab
*.msi
*.msix
*.msm
*.msp

# ---------------------------------------------------------
# IDE / 에디터
# ---------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/

# VS Code (팀 공유 설정만 커밋)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.code-workspace

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Vim / Emacs / 기타
*.swp
*.swo
*~
\#*\#
.\#*

# ---------------------------------------------------------
# AI 에이전트 개인 설정 (공유 설정 CLAUDE.md, AGENTS.md는 커밋)
# ---------------------------------------------------------
CLAUDE.local.md
.claude/settings.local.json
.claude/*.local.*
.aider*
.cursor/*.local*

# ---------------------------------------------------------
# 로그 / 임시 파일
# ---------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
hs_err_pid*
replay_pid*
*.tmp
*.temp
tmp/
temp/

# =========================================================
# Frontend — React + TypeScript (frontend/)
# =========================================================

# 의존성
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
jspm_packages/

# 빌드 결과물
frontend/dist/
frontend/build/
dist-ssr/
.next/
.nuxt/
.output/
.vite/
.parcel-cache/
.turbo/
storybook-static/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# 캐시
.eslintcache
.stylelintcache
.npm/
.cache/

# 테스트 / 커버리지
coverage/
*.lcov
.nyc_output/
playwright-report/
test-results/
blob-report/
playwright/.cache/
cypress/videos/
cypress/screenshots/

# 배포 도구 로컬 정보
.vercel
.netlify

# =========================================================
# Backend — Java + Spring (backend/)
# =========================================================

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Maven
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar.bak

# 컴파일 결과물 / 패키지
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar
!.mvn/wrapper/maven-wrapper.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Spring Boot
spring-boot-devtools.properties
.attach_pid*

# QueryDSL 등 어노테이션 프로세서 생성 코드
**/src/main/generated/
generated/

# 로컬 DB 파일 (H2 등)
*.db
*.h2.db
*.mv.db
*.trace.db

# AI로 만든 임시 이미지 (디자인 확정 전 임시본, 커밋하지 않음)
frontend/public/art-temp/

# 게임 글꼴을 재현한 임시 폰트 (라이선스 동의 후 각자 받아 넣음, 커밋하지 않음)
frontend/public/fonts-temp/
